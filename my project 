import sqlite3 

def connect():
   conn = sqlite3.connect("Students3.db")
   return conn
   
def create_table():
    conn = connect()
    cursor = conn.cursor()
    cursor.execute("CREATE TABLE IF NOT EXISTS students (roll_no INTEGER PRIMARY KEY, name TEXT NOT NULL, marks INTEGER, class_name INTEGER)")
    conn.commit()
    conn.close()
    print("Table created successfully ! ")

create_table()

def add_student():
    conn = connect()
    cursor = conn.cursor()
    roll_no = int(input("Enter roll number : "))
    name = input("Enter your name : ")
    marks = int(input("Enter marks : "))
    class_name = (input("Enter your class : "))
    try:
       cursor.execute("INSERT INTO                        students      VALUES (?,?,?,?)" ,                     (roll_no
        ,name,marks,       class_name))
       conn.commit()
       print("Student added successfully ! ")
    except:
        print("Error! Roll number already                   exists!")
    conn.close()
add_student()

def view_students():
    conn = connect()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM students")
    students = cursor.fetchall()
    if len(students) == 0:
        print("No students found ! ")
    else:            
        print("roll_no,name,marks,class_name")
        print("____________________")
        for s in students:
            print(s[0], "|" ,s[1], "|" ,s[2], "|" ,s[3])
    conn.close()
    
view_students()

def update_student():
    conn = connect()
    cursor = conn.cursor()
    roll_no = int(input("Enter roll number to update : "))
    new_name = input("Enter new name : ")
    cursor.execute("UPDATE students SET name = ? WHERE roll_no = ?" , (new_name,roll_no))
    conn.commit()
    conn.close()
    print("Name updated successfully ! ")
    
update_student()

